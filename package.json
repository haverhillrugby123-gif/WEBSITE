{
  "name": "uk-online-tuition-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-site.mjs",
    "build": "node scripts/build-site.mjs",
    "build:root": "node scripts/build-site.mjs --root",
    "build:enquiry-preview": "node scripts/build-site.mjs --root --main-enquiry-preview",
    "test:root": "playwright test --config playwright.root.config.mjs",
    "test:enquiry-preview": "playwright test --config playwright.enquiry.config.mjs",
    "test:browser": "playwright test",
    "test:browser:repeat": "playwright test --repeat-each=10",
    "smoke:deployed": "node scripts/smoke-deployed.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "^8.3.0"
  }
}
